#!/usr/bin/env bash
# Track the live status of the `claude` session running in this tmux pane, so
# dai-bar can list EVERY session and its state at a glance. The pane stays
# listed the whole time claude runs; only the status changes.
#
# dai-bar finds the panes on its own (pane_current_command == claude); this
# script only maintains the pane option @dai_bar_wait with the detailed state:
#   perm     needs your authorization (permission prompt)  -> urgent, top
#   done     finished, and you have not looked yet         -> your turn
#   working  processing (you just submitted, or booting)    -> no action
#   waiting  seen — written by dai-bar when you look at the pane, never here
#
# Driven by Claude Code hooks (see ~/.claude/settings.json):
#   stop   -> done      (Stop hook: finished a response)
#   notify -> perm|done (Notification hook: parses the message)
#   submit -> working   (UserPromptSubmit: you sent input, now processing)
#
# Anchors on $TMUX_PANE so it targets the right pane regardless of focus.
set -euo pipefail

action="${1:-}"
[[ -n "${TMUX_PANE:-}" ]] || exit 0
p="$TMUX_PANE"

new=""
case "$action" in
  stop)   new="done" ;;
  submit) new="working" ;;
  notify)
    # Notification fires for permission prompts AND idle waits. Distinguish by
    # the message text on stdin (raw JSON grep is enough and robust).
    msg="$(cat 2>/dev/null || true)"
    case "$msg" in
      *permission*|*Permission*) new="perm" ;;
      *)                         new="done" ;;
    esac ;;
  *) exit 0 ;;
esac

cur="$(tmux show -p -t "$p" -v @dai_bar_wait 2>/dev/null || true)"
[[ "$cur" == "$new" ]] && exit 0   # no change -> no repaint

tmux set -p -t "$p" @dai_bar_wait "$new" 2>/dev/null || true
tmux set -p -t "$p" @dai_bar_wait_since "$(date +%s)" 2>/dev/null || true
tmux refresh-client -S 2>/dev/null || true

# Audible ping on the transitions that want your attention (guarded above, so
# only on the actual state change), async so it never blocks the hook:
#   perm -> needs your authorization  (urgent)
#   done -> finished, your turn       (softer, "maybe continue")
# Both gated by the tmux global @dai_bar_sound, toggled from the dai-bar UI
# (the ♫ chip). Override the files with DAI_BAR_SOUND_PERM / DAI_BAR_SOUND_DONE.
snd=""
case "$new" in
  perm) snd="${DAI_BAR_SOUND_PERM:-/usr/share/sounds/freedesktop/stereo/complete.oga}" ;;
  done) snd="${DAI_BAR_SOUND_DONE:-/usr/share/sounds/freedesktop/stereo/bell.oga}" ;;
esac
if [[ -n "$snd" ]]; then
  gate="$(tmux show -gv @dai_bar_sound 2>/dev/null || true)"
  if [[ "$gate" == "on" && -r "$snd" ]] && command -v paplay >/dev/null 2>&1; then
    paplay "$snd" >/dev/null 2>&1 &
  fi
fi
