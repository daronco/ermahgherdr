[Unit]
Description=erma serve — read-only HTTP view of Claude tmux sessions

[Service]
# Auth is resolved from `tailscale status` by default; override with --tailscale-login or $ERMA_TAILSCALE_LOGIN.
ExecStart=%h/.local/bin/erma serve --addr 127.0.0.1:8731
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
