#!/usr/bin/env bash
# Open erdr in a foot window, or focus it if already open.
# Tags the window with a stable app_id so sway can size/find it and the
# focus daemon can tell it apart from real terminals.
set -euo pipefail
APP="${ERDR_APP_ID:-erdr}"
# capture the tree first: piping into `grep -q` can SIGPIPE swaymsg, which with
# `pipefail` would flakily read as "not found" and open a duplicate window.
tree="$(swaymsg -t get_tree 2>/dev/null || true)"
if grep -qE "\"app_id\": *\"${APP}\"" <<<"$tree"; then
  swaymsg "[app_id=\"${APP}\"] focus" >/dev/null 2>&1
  exit 0
fi
# resolve an absolute binary path (the terminal inherits sway's env, not your
# shell PATH), preferring where `go install` drops it.
BIN=""
for c in "$HOME/go/bin/erdr" "$HOME/.local/bin/erdr" "$HOME/.dotfiles/bin/erdr"; do
  [ -x "$c" ] && { BIN="$c"; break; }
done
[ -z "$BIN" ] && BIN="$(command -v erdr 2>/dev/null || echo erdr)"
# foot by default. Another terminal: set ERDR_TERMINAL — but check how it
# spells the window tag first (alacritty/kitty use --class, not --app-id).
exec "${ERDR_TERMINAL:-foot}" --app-id="${APP}" -e "$BIN" "$@"
